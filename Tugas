<script>
// ===== SPA NAVIGATION =====
const PAGES = {
  home:'page-home', story:'page-story', ranks:'page-ranks',
  characters:'page-characters', abilities:'page-abilities',
  world:'page-world', mulai:'page-mulai'
};

function nav(page) {
  // hide all
  Object.values(PAGES).forEach(id => {
    const el = document.getElementById(id);
    if(el) el.classList.remove('active');
  });
  // show target
  const target = document.getElementById(PAGES[page]);
  if(target) {
    target.classList.add('active');
    window.scrollTo({top:0, behavior:'smooth'});
  }
  // update nav active state
  document.querySelectorAll('.nav-links button[data-page]').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.page === page);
  });
  // trigger reveal for newly shown page
  setTimeout(initReveal, 100);
}

// World tabs
function showWorldTab(tab, btn) {
  document.querySelectorAll('.wpanel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.wtab').forEach(b => b.classList.remove('active'));
  const panel = document.getElementById('wpanel-' + tab);
  if(panel) panel.classList.add('active');
  btn.classList.add('active');
}

// Mobile menu
function openMobile() { document.getElementById('mobileMenu').classList.add('open'); document.body.style.overflow='hidden'; }
function closeMobile() { document.getElementById('mobileMenu').classList.remove('open'); document.body.style.overflow=''; }

// Scroll reveal
function initReveal() {
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if(e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 70);
        obs.unobserve(e.target);
      }
    });
  }, {threshold: 0.08});
  document.querySelectorAll('.reveal:not(.visible)').forEach(el => obs.observe(el));
}
initReveal();

// Particles
(function(){
  const c = document.getElementById('particles');
  const colors = ['#1a6cf5','#00e5ff','#4090ff','#c9a227','#8b2be2','#f0d060'];
  function mk(){
    const el = document.createElement('div');
    el.className = 'spark';
    const s = Math.random()*4+2;
    Object.assign(el.style, {
      width:s+'px', height:s+'px',
      background:colors[Math.floor(Math.random()*colors.length)],
      left:Math.random()*100+'%',
      bottom:'-10px',
      animationDuration:(3+Math.random()*5)+'s',
      animationDelay:(Math.random()*8)+'s',
      opacity:'0'
    });
    c.appendChild(el);
    setTimeout(()=>el.remove(), 14000);
  }
  for(let i=0;i<30;i++) mk();
  setInterval(mk, 600);
})();

// Nav scroll effect
window.addEventListener('scroll', () => {
  document.getElementById('mainNav').style.borderBottomColor =
    window.scrollY > 40 ? 'rgba(201,162,39,0.28)' : 'rgba(201,162,39,0.18)';
});
</script>
